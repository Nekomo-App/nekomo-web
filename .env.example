# Copy to .env.local and fill in values. Never commit real secrets.

# --- Database (optional; watchlist/history default to browser localStorage) ---
DATABASE_URL=

# --- Auth (reserved for a future account system) ---
AUTH_SECRET=

# --- Anime metadata provider ---
# Defaults to the free, documented Jikan API (https://docs.api.jikan.moe) — no key required.
ANIME_METADATA_API_URL=https://api.jikan.moe/v4
ANIME_METADATA_API_KEY=

# --- Authorized streaming provider (optional) ---
# Wire to a licensed catalog/streaming partner when available.
OFFICIAL_STREAMING_API_URL=
OFFICIAL_STREAMING_API_KEY=

# --- Object storage (optional, for uploaded artwork) ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Site ---
DMCA_CONTACT_EMAIL=legal@nekomo.example
SITE_URL=http://localhost:3000
